<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="MauiMunicipio.Controls.MunicipalHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid BackgroundColor="{StaticResource PrimaryBlue}"
          Padding="16,12"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="12">
        <Button Grid.Column="0"
                IsVisible="{Binding ShowBack, Source={x:Reference Root}}"
                Text="‹"
                Clicked="OnBackClicked"
                FontSize="29"
                WidthRequest="38"
                HeightRequest="38"
                Padding="0"
                CornerRadius="19"
                BackgroundColor="#1AFFFFFF"
                TextColor="White" />

        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border WidthRequest="34" HeightRequest="34"
                    BackgroundColor="White" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17" />
                </Border.StrokeShape>
                <Label Text="Q"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="{StaticResource PrimaryBlue}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       TextColor="White"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
                       FontSize="9"
                       TextColor="#D8E9F7"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>

        <Button Grid.Column="2"
                Text="☰"
                Clicked="OnMenuClicked"
                FontSize="18"
                WidthRequest="38"
                HeightRequest="38"
                Padding="0"
                CornerRadius="19"
                BackgroundColor="#1AFFFFFF"
                TextColor="White" />
    </Grid>
</ContentView>
