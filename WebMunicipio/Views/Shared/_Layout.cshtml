<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Municipio Digital</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>

<body>

    <!--==============================-->
    <!-- NAVBAR -->
    <!--==============================-->

    <nav class="navbar navbar-expand-lg navbar-dark shadow">

        <div class="container">

            <a asp-controller="Home"
               asp-action="Index"
               class="navbar-brand d-flex align-items-center">

                <img src="~/images/logo.png"
                     height="55"
                     class="me-3" />

                <div>

                    <div class="fw-bold fs-4">

                        Municipio Digital

                    </div>

                    <small>

                        Administración Zonal

                    </small>

                </div>

            </a>


            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse"
                 id="menu">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Inicio
                        </a>
                    </li>

                    <!-- Participación -->

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            Participación Ciudadana

                        </a>

                        <ul class="dropdown-menu">

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Talleres"
                                   asp-action="Index">

                                    Talleres

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Ferias"
                                   asp-action="Index">

                                    Ferias

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Campanias"
                                   asp-action="Index">

                                    Campañas

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Inscripciones"
                                   asp-action="Index">

                                    Inscripciones

                                </a>

                            </li>

                        </ul>

                    </li>

                    <!-- Reportes -->

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            Reportes

                        </a>

                        <ul class="dropdown-menu">

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Reportes"
                                   asp-action="Index">

                                    Reportes Ciudadanos

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Alertas"
                                   asp-action="Index">

                                    Alertas

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="SituacionCalles"
                                   asp-action="Index">

                                    Situación de Calle

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="ReporteViolencias"
                                   asp-action="Index">

                                    Violencia

                                </a>

                            </li>

                        </ul>

                    </li>

                    <!-- Solicitudes -->

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            Solicitudes

                        </a>

                        <ul class="dropdown-menu">

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Obras"
                                   asp-action="Index">

                                    Obras

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Reservas"
                                   asp-action="Index">

                                    Reservas

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Permisos"
                                   asp-action="Index">

                                    Permisos

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Consultas"
                                   asp-action="Index">

                                    Impuestos

                                </a>

                            </li>

                        </ul>

                    </li>

                </ul>



                @if (Context.Session.GetString("Nombre") == null)
                {

                    <div class="d-flex">

                        <a asp-controller="Ingreso"
                           asp-action="Login"
                           class="btn btn-outline-light me-2">

                            <i class="bi bi-box-arrow-in-right"></i>

                            Login

                        </a>

                        <a asp-controller="Ingreso"
                           asp-action="Registro"
                           class="btn btn-warning">

                            Registrarse

                        </a>

                    </div>

                }

                else
                {

                    <div class="dropdown">

                        <button class="btn btn-light dropdown-toggle"
                                data-bs-toggle="dropdown">

                            <i class="bi bi-person-circle"></i>

                            @Context.Session.GetString("Nombre")

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>

                                <span class="dropdown-item-text">

                                    Rol:

                                    <strong>

                                        @Context.Session.GetString("Rol")

                                    </strong>

                                </span>

                            </li>

                            <li>

                                <hr class="dropdown-divider">

                            </li>

                            <li>

                                <a asp-controller="Ingreso"
                                   asp-action="Logout"
                                   class="dropdown-item text-danger">

                                    Cerrar sesión

                                </a>

                            </li>

                        </ul>

                    </div>

                }

            </div>

        </div>

    </nav>


    <main class="container mt-navbar">

        @RenderBody()

    </main>


    <!--==============================-->
    <!-- FOOTER -->
    <!--==============================-->

    <footer class="footer mt-5">

        <div class="container text-center py-4">

            <h5>

                Municipio Digital

            </h5>

            <p>

                Plataforma de servicios ciudadanos del Distrito Metropolitano de Quito.

            </p>

            <small>

                © @DateTime.Now.Year

                Todos los derechos reservados.

            </small>

        </div>

    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>