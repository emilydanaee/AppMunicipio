@model WebMunicipio.Models.Feria

@{
    ViewData["Title"] = "Editar Feria";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3>Editar Feria</h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <input asp-for="IdFeria" hidden />

                <div class="mb-3">

                    <label asp-for="NombreFeria"></label>

                    <input asp-for="NombreFeria"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="DescripcionFeria"></label>

<textarea asp-for="DescripcionFeria"
          rows="4"
          class="form-control"></textarea>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label asp-for="FechaInicio"></label>

                        <input asp-for="FechaInicio"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="FechaFin"></label>

                        <input asp-for="FechaFin"
                               type="date"
                               class="form-control" />

                    </div>

                </div>

                <br />

                <div class="mb-3">

                    <label asp-for="SectorFeria"></label>

                    <input asp-for="SectorFeria"
                           class="form-control" />

                </div>

                <button class="btn btn-warning">

                    Actualizar

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>