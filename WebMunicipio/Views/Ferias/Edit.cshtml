@model WebMunicipio.Models.Feria

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header text-white"
             style="background-color:#0A2A65;">
            <h3>✏ Editar Feria</h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">

                <input asp-for="IdFeria" type="hidden" />
                <input asp-for="ImagenFeria" type="hidden" />
                
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Nombre del Feria</label>
                        <input asp-for="NombreFeria" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SectorFeria" class="form-label"></label>

                        <select asp-for="SectorFeria" class="form-select">
                            <option value="">-- Seleccione un sector --</option>
                            <option>Calderón</option>
                            <option>Centro</option>
                            <option>Chillogallo</option>
                            <option>Cotocollao</option>
                            <option>Eloy Alfaro</option>
                            <option>La Delicia</option>
                            <option>La Mariscal</option>
                            <option>Quitumbe</option>
                            <option>Tumbaco</option>
                            <option>Valle de Los Chillos</option>
                        </select>

                        <span asp-validation-for="SectorFeria" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="UbicacionFeria"></label>
                    <input asp-for="UbicacionFeria"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Descripción</label>
                    <textarea asp-for="DescripcionFeria"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label>Fecha Inicio</label>
                        <input asp-for="FechaInicio" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Fecha Fin</label>
                        <input asp-for="FechaFin" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Hora Inicio</label>
                        <input asp-for="HoraInicio" type="time" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Hora Fin</label>
                        <input asp-for="HoraFin" type="time" class="form-control" />
                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">Imagen Actual</label>

                    <br />

                    @if (!string.IsNullOrWhiteSpace(Model.ImagenFeria))
                    {
                        <img src="https://localhost:7061/@Model.ImagenFeria"
                             class="img-thumbnail mb-3"
                             style="max-height:180px;" />
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            Sin imagen
                        </div>
                    }

                </div>

                <div class="mb-3">

                    <label class="form-label">Nueva Imagen</label>

                    <input asp-for="Imagen"
                           type="file"
                           class="form-control" />

                </div>

                <button type="submit" class="btn btn-warning">
                    Guardar Cambios
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>