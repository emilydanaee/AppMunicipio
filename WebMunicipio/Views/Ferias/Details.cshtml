@model WebMunicipio.Models.Feria

@{
    ViewData["Title"] = "Detalle de la Feria";
}

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header text-white"
             style="background:#0A2A65">

            <h2>@Model.NombreFeria</h2>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- IMAGEN -->

                <div class="col-lg-5">

                    @if (!string.IsNullOrWhiteSpace(Model.ImagenFeria))
                    {
                        <img src="https://localhost:7061/@Model.ImagenFeria"
                             class="img-fluid rounded shadow"
                             alt="@Model.NombreFeria" />
                    }
                    else
                    {
                        <img src="~/images/no-image.png"
                             class="img-fluid rounded shadow"
                             alt="Sin imagen" />
                    }

                </div>

                <!-- INFORMACIÓN -->

                <div class="col-lg-7">

                    <h4 class="text-primary">

                        Información

                    </h4>

                    <hr />

                    <p>

                        <strong>Descripción</strong>

                        <br />

                        @Model.DescripcionFeria

                    </p>

                    <p>

                        <strong>Sector</strong>

                        <br />

                        @Model.SectorFeria

                    </p>

                    <p>

                        <strong>Ubicación</strong>

                        <br />

                        @Model.UbicacionFeria

                    </p>

                    <div class="row">

                        <div class="col-md-6">

                            <strong>Fecha Inicio</strong>

                            <br />

                            @Model.FechaInicio

                        </div>

                        <div class="col-md-6">

                            <strong>Fecha Fin</strong>

                            <br />

                            @Model.FechaFin

                        </div>

                    </div>

                    <br />

                    <div class="row">

                        <div class="col-md-6">

                            <strong>Hora Inicio</strong>

                            <br />

                            @Model.HoraInicio

                        </div>

                        <div class="col-md-6">

                            <strong>Hora Fin</strong>

                            <br />

                            @Model.HoraFin

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="text-end">

        <a asp-action="Index"
           class="btn btn-secondary">

            Volver

        </a>

        @if (Context.Session.GetString("Rol") == "Admin")
        {

            <a asp-action="Edit"
               asp-route-id="@Model.IdFeria"
               class="btn btn-warning">

                Editar

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.IdFeria"
               class="btn btn-danger">

                Eliminar

            </a>

        }

    </div>

</div>