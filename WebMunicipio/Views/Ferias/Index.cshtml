@model List<WebMunicipio.Models.Feria>

<h1>Ferias</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Fecha</th>
            <th>Ubicación</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var feria in Model)
        {
            <tr>
                <td>@feria.NombreFeria</td>
                <td>@feria.DescripcionFeria</td>
                <td>@feria.FechaFeria</td>
                <td>@feria.SectorFeria</td>
            </tr>
        }
    </tbody>
</table>