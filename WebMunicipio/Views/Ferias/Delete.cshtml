@model WebMunicipio.Models.Feria

@{
    ViewData["Title"] = "Eliminar Feria";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h3>

                Eliminar Feria

            </h3>

        </div>

        <div class="card-body">

            <h4>

                ¿Desea eliminar esta feria?

            </h4>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">

                    Nombre

                </dt>

                <dd class="col-sm-9">

                    @Model.NombreFeria

                </dd>

                <dt class="col-sm-3">

                    Descripción

                </dt>

                <dd class="col-sm-9">

                    @Model.DescripcionFeria

                </dd>

                <dt class="col-sm-3">

                    Sector

                </dt>

                <dd class="col-sm-9">

                    @Model.SectorFeria

                </dd>

                <dt class="col-sm-3">

                    Fechas

                </dt>

                <dd class="col-sm-9">

                    @Model.FechaInicio.ToShortDateString()

                    -

                    @Model.FechaFin.ToShortDateString()

                </dd>

            </dl>

            <form asp-action="Delete">

                <input asp-for="IdFeria" hidden />

                <button class="btn btn-danger">

                    Eliminar

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>