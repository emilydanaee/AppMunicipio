@model List<WebMunicipio.Models.Solicitud>

<h1>Solicitudes</h1>

<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Descripción</th>
            <th>Fecha de Solicitud</th>
            <th>Estado</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var solicitud in Model)
        {
            <tr>
                <td>@solicitud.TipoSolicitud</td>
                <td>@solicitud.DescripcionSolicitud</td>
                <td>@solicitud.FechaSolicitud</td>
                <td>@solicitud.EstadoSolicitud</td>
            </tr>
        }
    </tbody>
</table>