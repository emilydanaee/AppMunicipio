@model WebMunicipio.Models.Taller

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header text-white"
             style="background-color:#0A2A65;">
            <h3>✏ Editar Taller</h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input asp-for="IdTaller" type="hidden" />
                <input asp-for="ImagenTaller" type="hidden" />
                <input asp-for="Inscritos" type="hidden" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Nombre del Taller</label>
                        <input asp-for="NombreTaller" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SectorTaller" class="form-label"></label>

                        <select asp-for="SectorTaller" class="form-select">
                            <option value="">-- Seleccione un sector --</option>
                            <option>Calderón</option>
                            <option>Centro</option>
                            <option>Chillogallo</option>
                            <option>Cotocollao</option>
                            <option>Eloy Alfaro</option>
                            <option>La Delicia</option>
                            <option>La Mariscal</option>
                            <option>Quitumbe</option>
                            <option>Tumbaco</option>
                            <option>Valle de Los Chillos</option>
                        </select>

                        <span asp-validation-for="SectorTaller" class="text-danger"></span>
                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="UbicacionTaller"></label>
                        <input asp-for="UbicacionTaller"
                               class="form-control" />
                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Instructor"></label>
                        <input asp-for="Instructor"
                               class="form-control" />
                    </div>

                    <div class="col-md-12 mb-3">

                        <label class="form-label">Días del Taller</label>

                        <div class="row">

                            <div class="col-md-3">
                                <input class="form-check-input dia" type="checkbox" value="Lunes" />
                                <label class="form-check-label">Lunes</label>
                            </div>

                            <div class="col-md-3">
                                <input class="form-check-input dia" type="checkbox" value="Martes" />
                                <label class="form-check-label">Martes</label>
                            </div>

                            <div class="col-md-3">
                                <input class="form-check-input dia" type="checkbox" value="Miércoles" />
                                <label class="form-check-label">Miércoles</label>
                            </div>

                            <div class="col-md-3">
                                <input class="form-check-input dia" type="checkbox" value="Jueves" />
                                <label class="form-check-label">Jueves</label>
                            </div>

                            <div class="col-md-3 mt-2">
                                <input class="form-check-input dia" type="checkbox" value="Viernes" />
                                <label class="form-check-label">Viernes</label>
                            </div>

                            <div class="col-md-3 mt-2">
                                <input class="form-check-input dia" type="checkbox" value="Sábado" />
                                <label class="form-check-label">Sábado</label>
                            </div>

                            <div class="col-md-3 mt-2">
                                <input class="form-check-input dia" type="checkbox" value="Domingo" />
                                <label class="form-check-label">Domingo</label>
                            </div>

                        </div>

                        <input asp-for="Dias" type="hidden" id="Dias" />
                        
                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Modalidad" class="form-label"></label>

                        <select asp-for="Modalidad" class="form-select">

                            <option value="">Seleccione una modalidad</option>

                            <option>Presencial</option>
                            <option>Virtual</option>
                            <option>Híbrida</option>

                        </select>

                        <span asp-validation-for="Modalidad" class="text-danger"></span>

                    </div>

                </div>

                <div class="mb-3">
                    <label>Descripción</label>
                    <textarea asp-for="DescripcionTaller"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label>Fecha Inicio</label>
                        <input asp-for="FechaInicio" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Fecha Fin</label>
                        <input asp-for="FechaFin" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Hora Inicio</label>
                        <input asp-for="HoraInicio" type="time" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Hora Fin</label>
                        <input asp-for="HoraFin" type="time" class="form-control" />
                    </div>

                </div>

                <div class="mb-3">
                    <label>Cupos</label>
                    <input asp-for="CuposTaller" class="form-control" />
                </div>

                <div class="mb-3">

                    <label class="form-label">Imagen Actual</label>

                    <br />

                    @if (!string.IsNullOrWhiteSpace(Model.ImagenTaller))
                    {
                        <img src="https://localhost:7061/@Model.ImagenTaller"
                             class="img-thumbnail mb-3"
                             style="max-height:180px;" />
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            Sin imagen
                        </div>
                    }

                </div>

                <div class="mb-3">

                    <label class="form-label">Nueva Imagen</label>

                    <input asp-for="Imagen"
                           type="file"
                           class="form-control" />

                </div>

                <button type="submit" class="btn btn-warning">
                    Guardar Cambios
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts{

    <partial name="_ValidationScriptsPartial" />

    <script>

        // Obtiene los días guardados en la BD
        let diasGuardados = document.getElementById("Dias").value;

        if (diasGuardados !== "") {

            let lista = diasGuardados.split(",");

            document.querySelectorAll(".dia").forEach(function (c) {

                if (lista.map(x => x.trim()).includes(c.value))
                    c.checked = true;

            });

        }

        // Cuando cambian los checkboxes,
        // actualizar el campo oculto

        document.querySelectorAll(".dia").forEach(function (checkbox) {

            checkbox.addEventListener("change", function () {

                let dias = [];

                document.querySelectorAll(".dia:checked").forEach(function (c) {

                    dias.push(c.value);

                });

                document.getElementById("Dias").value = dias.join(", ");

            });

        });

    </script>

}