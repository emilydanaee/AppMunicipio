@model WebMunicipio.Models.Taller

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header text-white"
             style="background-color:#0A2A65;">
            <h3>✏ Editar Taller</h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="IdTaller" type="hidden" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Nombre del Taller</label>
                        <input asp-for="NombreTaller" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SectorTaller" class="form-label"></label>

                        <select asp-for="SectorTaller" class="form-select">
                            <option value="">-- Seleccione un sector --</option>
                            <option>Calderón</option>
                            <option>Centro</option>
                            <option>Chillogallo</option>
                            <option>Cotocollao</option>
                            <option>Eloy Alfaro</option>
                            <option>La Delicia</option>
                            <option>La Mariscal</option>
                            <option>Quitumbe</option>
                            <option>Tumbaco</option>
                            <option>Valle de Los Chillos</option>
                        </select>

                        <span asp-validation-for="SectorTaller" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Instructor"></label>
                        <input asp-for="Instructor"
                               class="form-control" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Días del Taller</label>

                        <div class="row">

                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="DiasSeleccionados"
                                           value="Lunes"
                                           id="lunes">
                                    <label class="form-check-label" for="lunes">
                                        Lunes
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="DiasSeleccionados"
                                           value="Martes"
                                           id="martes">
                                    <label class="form-check-label" for="martes">
                                        Martes
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="DiasSeleccionados"
                                           value="Miércoles"
                                           id="miercoles">
                                    <label class="form-check-label" for="miercoles">
                                        Miércoles
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="DiasSeleccionados"
                                           value="Jueves"
                                           id="jueves">
                                    <label class="form-check-label" for="jueves">
                                        Jueves
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-3 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="DiasSeleccionados"
                                           value="Viernes"
                                           id="viernes">
                                    <label class="form-check-label" for="viernes">
                                        Viernes
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-3 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="DiasSeleccionados"
                                           value="Sábado"
                                           id="sabado">
                                    <label class="form-check-label" for="sabado">
                                        Sábado
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-3 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="DiasSeleccionados"
                                           value="Domingo"
                                           id="domingo">
                                    <label class="form-check-label" for="domingo">
                                        Domingo
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>

                    <select asp-for="Modalidad"
                            class="form-select">

                        <option>Presencial</option>

                        <option>Virtual</option>

                        <option>Híbrida</option>

                    </select>

                </div>

                <div class="mb-3">
                    <label>Descripción</label>
                    <textarea asp-for="DescripcionTaller"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label>Fecha Inicio</label>
                        <input asp-for="FechaInicio" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Fecha Fin</label>
                        <input asp-for="FechaFin" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Hora Inicio</label>
                        <input asp-for="HoraInicio" type="time" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Hora Fin</label>
                        <input asp-for="HoraFin" type="time" class="form-control" />
                    </div>

                </div>

                <div class="mb-3">
                    <label>Cupos</label>
                    <input asp-for="CuposTaller" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Imagen (URL o ruta)</label>
                    <input asp-for="ImagenTaller" class="form-control" />
                </div>

                <button type="submit" class="btn btn-warning">
                    Guardar Cambios
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>