@model List<WebMunicipio.Models.Reporte>

@{
    ViewData["Title"] = "Reportes Ciudadanos";
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet/dist/leaflet.css" />

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-primary">

                <i class="bi bi-flag-fill"></i>

                Reportes Ciudadanos

            </h2>

            <p class="text-muted">

                Reporta daños en la infraestructura pública y consulta los reportes realizados por la comunidad.

            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-circle"></i>

            Nuevo Reporte

        </a>

    </div>

    <!-- TABS -->

    <ul class="nav nav-tabs">

        <li class="nav-item">

            <button class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#lista">

                Lista

            </button>

        </li>

        <li class="nav-item">

            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#mapa">

                Mapa

            </button>

        </li>

    </ul>

    <div class="tab-content mt-3">

        <!-- TAB LISTA -->

        <div class="tab-pane fade show active"
             id="lista">

            <div class="card shadow">

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-md-4">

                            <input id="buscar"
                                   class="form-control"
                                   placeholder="Buscar..."
                                   onkeyup="filtrar()" />

                        </div>

                        <div class="col-md-3">

                            <select id="tipo"
                                    class="form-select"
                                    onchange="filtrar()">

                                <option value="">Todos los tipos</option>

                                <option>Bache</option>

                                <option>Fuga de agua</option>

                                <option>Alumbrado público</option>

                                <option>Basura</option>

                                <option>Semáforo dañado</option>

                                <option>Parque deteriorado</option>

                                <option>Árbol caído</option>

                                <option>Otro</option>

                            </select>

                        </div>

                        <div class="col-md-3">

                            <select id="estado"
                                    class="form-select"
                                    onchange="filtrar()">

                                <option value="">Todos los estados</option>

                                <option>Pendiente</option>

                                <option>En proceso</option>

                                <option>Resuelto</option>

                            </select>

                        </div>

                    </div>

                    <table class="table table-hover">

                        <thead class="table-dark">

                            <tr>

                                <th>Tipo</th>

                                <th>Descripción</th>

                                <th>Fecha</th>

                                <th>Detalle</th>

                                <th>Estado</th>

                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr class="fila">

                                    <td>@item.TipoReporte</td>

                                    <td>@item.DescripcionReporte</td>

                                    <td>@item.FechaReporte.ToShortDateString()</td> 

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdReporte"
                                           class="btn btn-primary btn-sm">

                                            Ver

                                        </a>

                                        @if (Context.Session.GetString("Rol") == "Admin")
                                        {

                                            <a asp-action="Delete"
                                               asp-route-id="@item.IdReporte"
                                               class="btn btn-danger btn-sm">

                                                Eliminar

                                            </a>
                                        }

                                    </td>

                                    <td>

                                        @if (Context.Session.GetString("Rol") == "Admin")
                                        {
                                            <form asp-action="ActualizarEstado"
                                                  method="post"
                                                  class="d-flex">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.IdReporte" />

                                                <select name="estado"
                                                        class="form-select form-select-sm me-2">

                                                    <option selected="@(item.EstadoReporte == "Pendiente")">
                                                        Pendiente
                                                    </option>

                                                    <option selected="@(item.EstadoReporte == "En proceso")">
                                                        En proceso
                                                    </option>

                                                    <option selected="@(item.EstadoReporte == "Resuelto")">
                                                        Resuelto
                                                    </option>

                                                </select>

                                                <button class="btn btn-success btn-sm">

                                                    <i class="bi bi-check-lg"></i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            if (item.EstadoReporte == "Pendiente")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Pendiente
                                                </span>
                                            }
                                            else if (item.EstadoReporte == "En proceso")
                                            {
                                                <span class="badge bg-primary">
                                                    En proceso
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    Resuelto
                                                </span>
                                            }
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- TAB MAPA -->

        <div class="tab-pane fade"
             id="mapa">

            <div class="card shadow">

                <div class="card-body">

                    <div id="map"
                         style="height:650px;"></div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <script>

        function filtrar(){

        let texto=document.getElementById("buscar").value.toLowerCase();

        let tipo=document.getElementById("tipo").value.toLowerCase();

        let estado=document.getElementById("estado").value.toLowerCase();

        let filas=document.getElementsByClassName("fila");

        for(let fila of filas){

        let contenido=fila.innerText.toLowerCase();

        let mostrar=true;

        if(texto!="" && !contenido.includes(texto))
        mostrar=false;

        if(tipo!="" && !contenido.includes(tipo))
        mostrar=false;

        if(estado!="" && !contenido.includes(estado))
        mostrar=false;

        fila.style.display=mostrar?"":"none";

        }

        }


        var map=L.map('map').setView([-0.22985,-78.52495],12);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{

        maxZoom:19

        }).addTo(map);

        const tabMapa = document.querySelector('button[data-bs-target="#mapa"]');

        tabMapa.addEventListener('shown.bs.tab', function () {

            map.invalidateSize();

        });

        @foreach (var item in Model)
        {

            <text>

            var color='red';

            if("@item.EstadoReporte"=="En proceso")
            color='orange';

            if("@item.EstadoReporte"=="Resuelto")
            color='green';

            var marker=L.circleMarker(

            [@item.Latitud,@item.Longitud],

            {

            radius:8,

            color:color,

            fillColor:color,

            fillOpacity:0.8

            }

            ).addTo(map);

            marker.bindPopup(`

            <b>@item.TipoReporte</b><br>

            <b>Sector:</b> @item.Direccion<br>

            <b>Estado:</b> @item.EstadoReporte<br>

            <b>Fecha:</b> @item.FechaReporte.ToShortDateString()<br>

            @item.DescripcionReporte

            <br><br>

            @if (!string.IsNullOrWhiteSpace(item.ImagenReporte))
            {
                <text>

                <img src="https://localhost:7061/@item.ImagenReporte"

                style="width:220px;border-radius:8px;"/>

                </text>
            }

            `);

            </text>

        }

    </script>

}