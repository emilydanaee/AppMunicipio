@model List<WebMunicipio.Models.Reporte>

<h1>Reportes</h1>

<a asp-action="Create"
   class="btn btn-success mb-3">
    Nuevo Reporte
</a>


<table class="table">
    <thead>
        <tr>
            <th>Tipo </th>
            <th>Descripción</th>
            <th>Fecha</th>
            <th>Ubicación</th>
            <th>Estado</th>
            @if (Context.Session.GetString("Rol") == "Admin")
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>

    <tbody>
        @foreach (var reporte in Model)
        {
            <tr>
                <td>@reporte.TipoReporte</td>
                <td>@reporte.DescripcionReporte</td>
                <th>@reporte.FechaReporte</th>
                <td>@reporte.UbicacionReporte</td>
                <th>@reporte.EstadoReporte</th>
                @if (Context.Session.GetString("Rol") == "Admin")
                {
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@reporte.IdReporte"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@reporte.IdReporte"
                           class="btn btn-danger btn-sm">
                            Eliminar
                        </a>
                    </td>
                }
                
            </tr>
        }
    </tbody>
</table>