@model WebMunicipio.Models.Reporte

@{
    ViewData["Title"] = "Nuevo Reporte";


}


<div class="container mt-4">

<div class="card shadow-lg">

<div class="card-header bg-primary text-white">

<h3>
<i class="bi bi-exclamation-triangle-fill"></i>
Nuevo Reporte Ciudadano
</h3>

</div>

<div class="card-body">

<form asp-action="Create"
method="post"
enctype="multipart/form-data">
<partial name="_LeafletStyles" />
<div asp-validation-summary="All"
class="text-danger"></div>
                <div class="mb-3">

                    <label asp-for="TipoReporte"></label>

                    <select asp-for="TipoReporte" class="form-select">

                        <option value="">Seleccione...</option>

                        <option>Bache</option>

                        <option>Fuga de agua</option>

                        <option>Alumbrado público</option>

                        <option>Basura</option>

                        <option>Árbol caído</option>

                        <option>Semáforo dañado</option>

                        <option>Parque deteriorado</option>

                        <option>Otro</option>

                    </select>

                </div>
                <div class="mb-3">

                    <label asp-for="DescripcionReporte"></label>

                    <textarea asp-for="DescripcionReporte"
                      class="form-control"
                      rows="5"></textarea>

                </div>
                
                <input asp-for="Latitud" hidden id="Latitud" />

                <input asp-for="Longitud" hidden id="Longitud" />

                <div class="row">


                    <div class="col-md-6">

                        <label>Administración Zonal</label>

                        <input asp-for="AdministracionZonal"
                               id="AdministracionZonal"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="col-md-6">

                        <label>Parroquia</label>

                        <input asp-for="Parroquia"
                               id="Parroquia"
                               class="form-control"
                               readonly />

                    </div>


                </div>

                <div class="mb-3">

                    <label asp-for="Direccion"></label>

                    <input asp-for="Direccion"
                           id="Direccion"
                           class="form-control"
                           readonly />

                </div>

                <partial name="_MapaUbicacion" />
                <div class="mb-3">

                    <label>Fotografía</label>

                    <input asp-for="Imagen"
                           class="form-control" />

                </div>
                <div class="row">

                    <div class="col-md-4">

                        <label>Cédula</label>

                        <input asp-for="Cedula"
                               class="form-control" />

                    </div>

                    <div class="col-md-4">

                        <label>Correo</label>

                        <input asp-for="Correo"
                               class="form-control" />

                    </div>

                    <div class="col-md-4">

                        <label>Teléfono</label>

                        <input asp-for="Telefono"
                               class="form-control" />

                    </div>

                </div>

                <div class="mt-4 text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                    <button class="btn btn-primary">

                        Guardar Reporte

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <partial name="_LeafletScripts" />



}