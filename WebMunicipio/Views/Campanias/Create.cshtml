@model WebMunicipio.Models.Campania

@{
    ViewData["Title"] = "Nueva Campaña";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h3>Nueva Campaña</h3>

        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div class="mb-3">

                    <label asp-for="NombreCampania"></label>

                    <input asp-for="NombreCampania"
                           class="form-control" />

                    <span asp-validation-for="NombreCampania"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="DescripcionCampania"></label>

<textarea asp-for="DescripcionCampania"
          rows="4"
          class="form-control"></textarea>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label asp-for="FechaInicio"></label>

                        <input asp-for="FechaInicio"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="FechaFin"></label>

                        <input asp-for="FechaFin"
                               type="date"
                               class="form-control" />

                    </div>

                </div>

                <br />

                <div class="mb-3">

                    <label asp-for="SectorCampania"></label>

                    <input asp-for="SectorCampania"
                           class="form-control" />

                </div>

                <button class="btn btn-success">

                    Guardar Campaña

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}