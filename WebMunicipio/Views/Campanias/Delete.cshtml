@model WebMunicipio.Models.Campania

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header text-white bg-danger">
            <h3>🗑 Eliminar Campania</h3>
        </div>

        <div class="card-body">

            <h4 class="text-danger">
                ¿Estás seguro de eliminar esta campania?
            </h4>

            <hr />

            <div class="row">

                <div class="col-md-5 text-center">

                    @if (!string.IsNullOrWhiteSpace(Model.ImagenCampania))
                    {
                        <img src="https://localhost:7061/@Model.ImagenCampania"
                             class="img-fluid rounded shadow"
                             style="max-height:250px;"
                             alt="@Model.NombreCampania" />
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            Sin imagen disponible
                        </div>
                    }

                </div>

                <div class="col-md-7">

                    <p><strong>Nombre:</strong> @Model.NombreCampania</p>
                    <p><strong>Tipo:</strong> @Model.TipoCampania</p>
                    <p><strong>Ubicacion:</strong> @Model.UbicacionCampania</p>
                    <p><strong>Descripción:</strong> @Model.DescripcionCampania</p>
                    <p><strong>Responsable:</strong> @Model.ResponsableCampania</p>
                    <p><strong>Fechas:</strong> @Model.FechaInicio - @Model.FechaFin</p>
                    <p><strong>Horario:</strong> @Model.HoraInicio - @Model.HoraFin</p>

                </div>

            </div>

            <hr />

            <form asp-action="Delete" method="post">

                <input asp-for="IdCampania" type="hidden" />

                <button type="submit" class="btn btn-danger">
                    Confirmar Eliminación
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>