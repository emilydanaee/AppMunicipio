@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <img src="~/images/logo.png"
             alt="Logo Municipio"
             style="height:110px;" />

        <h1 class="fw-bold mt-3" style="color:#0A2A65;">
            Municipio Digital
        </h1>

        <p class="text-muted">
            Plataforma web para acceder a servicios municipales, participación ciudadana y reportes.
        </p>

    </div>

    <div class="row gy-4">

        <!-- PARTICIPACIÓN -->
        <div class="col-lg-4">

            <div class="card shadow h-100 border-0">

                <div class="card-header text-white text-center"
                     style="background:#0A2A65;">

                    <h3>Participación Ciudadana</h3>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-6">

                            <a href="/Talleres"
                               class="text-decoration-none">

                                <div class="card text-center h-100">

                                    <img src="~/images/talleres.png"
                                         class="card-img-top p-3"
                                         style="height:120px;object-fit:contain;" />

                                    <div class="card-body">

                                        <strong>Talleres</strong>

                                    </div>

                                </div>

                            </a>

                        </div>

                        <div class="col-6">

                            <a href="/Ferias"
                               class="text-decoration-none">

                                <div class="card text-center h-100">

                                    <img src="~/images/ferias.png"
                                         class="card-img-top p-3"
                                         style="height:120px;object-fit:contain;" />

                                    <div class="card-body">

                                        <strong>Ferias</strong>

                                    </div>

                                </div>

                            </a>

                        </div>

                        <div class="col-6">

                            <a href="/Campanias"
                               class="text-decoration-none">

                                <div class="card text-center h-100">

                                    <img src="~/images/campanias.png"
                                         class="card-img-top p-3"
                                         style="height:120px;object-fit:contain;" />

                                    <div class="card-body">

                                        <strong>Campañas</strong>

                                    </div>

                                </div>

                            </a>

                        </div>

                        <div class="col-6">

                            <a href="/Inscripciones"
                               class="text-decoration-none">

                                <div class="card text-center h-100">

                                    <img src="~/images/inscripcion.png"
                                         class="card-img-top p-3"
                                         style="height:120px;object-fit:contain;" />

                                    <div class="card-body">

                                        <strong>Inscripciones</strong>

                                    </div>

                                </div>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- REPORTES -->

        <div class="col-lg-4">

            <div class="card shadow h-100 border-0">

                <div class="card-header text-white text-center"
                     style="background:#D2251E;">

                    <h3>Reportes y Seguridad</h3>

                </div>

                <div class="card-body">

                    <div class="d-grid gap-3">

                        <a href="/Reportes"
                           class="btn btn-outline-danger">

                            Reportes Ciudadanos

                        </a>

                        <a href="/Alertas"
                           class="btn btn-outline-danger">

                            Alertas

                        </a>

                        <a href="/SituacionCalle"
                           class="btn btn-outline-danger">

                            Situación de Calle

                        </a>

                        <a href="/ReporteViolencias"
                           class="btn btn-outline-danger">

                            Violencia

                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- SOLICITUDES -->

        <div class="col-lg-4">

            <div class="card shadow h-100 border-0">

                <div class="card-header text-white text-center"
                     style="background:#1E8A4C;">

                    <h3>Solicitudes Ciudadanas</h3>

                </div>

                <div class="card-body">

                    <div class="d-grid gap-3">

                        <a href="/Obras"
                           class="btn btn-outline-success">

                            Obras Prioritarias

                        </a>

                        <a href="/Reservas"
                           class="btn btn-outline-success">

                            Reserva de Espacios

                        </a>

                        <a href="/Permisos"
                           class="btn btn-outline-success">

                            Permisos

                        </a>

                        <a href="/Consultas"
                           class="btn btn-outline-success">

                            Consulta de Impuestos

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>