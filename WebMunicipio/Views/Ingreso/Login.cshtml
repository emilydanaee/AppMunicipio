@model WebMunicipio.DTO.LoginDTO

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-header text-center text-white"
                     style="background-color:#0A2A65;">

                    <h3>Iniciar Sesión</h3>

                </div>

                <div class="card-body">

                    <form asp-action="Login" method="post">

                        <div class="mb-3">
                            <label>Email</label>
                            <input asp-for="Email"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Contraseña</label>
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control" />
                        </div>

                        <button class="btn w-100"
                                style="background-color:#0A2A65; color:white;">
                            Ingresar
                        </button>

                    </form>

                    <hr />

                    <div class="text-center">
                        <a asp-action="Registro">Crear cuenta</a>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-2">
                            @ViewBag.Error
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>