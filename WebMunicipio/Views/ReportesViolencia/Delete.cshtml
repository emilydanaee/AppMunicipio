@model WebMunicipio.Models.Campania

@{
    ViewData["Title"] = "Eliminar Campaña";
}

<div class="container mt-5">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">

            <h3>Eliminar Campaña</h3>

        </div>

        <div class="card-body">

            <h5 class="text-danger">

                ¿Está seguro de eliminar esta campaña?

            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-4">

                    Nombre

                </dt>

                <dd class="col-sm-8">

                    @Model.NombreCampania

                </dd>

                <dt class="col-sm-4">

                    Descripción

                </dt>

                <dd class="col-sm-8">

                    @Model.DescripcionCampania

                </dd>

                <dt class="col-sm-4">

                    Sector

                </dt>

                <dd class="col-sm-8">

                    @Model.SectorCampania

                </dd>

                <dt class="col-sm-4">

                    Duración

                </dt>

                <dd class="col-sm-8">

                    @Model.FechaInicio.ToString("dd/MM/yyyy")

                    -

                    @Model.FechaFin.ToString("dd/MM/yyyy")

                </dd>

            </dl>

            <form asp-action="Delete">

                <input asp-for="IdCampania" hidden />

                <button class="btn btn-danger">

                    Eliminar

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>