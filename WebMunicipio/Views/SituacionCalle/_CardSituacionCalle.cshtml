@model WebMunicipio.Models.SituacionCalle

<div class="card shadow-sm mb-3">

    <div class="card-body">

        <h5>👤 @Model.NombreReportante</h5>

        <p>
            📍 @Model.Direccion
        </p>

        <p>
            📝 @Model.Descripcion
        </p>

        <p>
            🔘 Estado:
            <span class="badge bg-secondary">
                @Model.Estado
            </span>
        </p>

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Details" asp-route-id="@Model.IdSituacionCalle"
               class="btn btn-sm btn-info">
                Ver
            </a>

            <a asp-action="Delete" asp-route-id="@Model.IdSituacionCalle"
               class="btn btn-sm btn-danger">
                Eliminar
            </a>

        </div>

    </div>
</div>