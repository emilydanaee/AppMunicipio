@model WebMunicipio.Models.SituacionCalle

@{
    ViewData["Title"] = "Reportar Persona en Situación de Calle";
}

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-primary text-white">

            <h3>
                <i class="bi bi-person-fill-exclamation"></i>
                Reportar Persona en Situación de Calle
            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <partial name="_LeafletStyles" />

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">

                    <label asp-for="NombreReportante"></label>

                    <input asp-for="NombreReportante"
                           class="form-control" />

                    <span asp-validation-for="NombreReportante"
                          class="text-danger"></span>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label asp-for="Condicion"></label>

                        <select asp-for="Condicion"
                                class="form-select">

                            <option value="">Seleccione...</option>

                            <option>Persona durmiendo</option>

                            <option>Persona desorientada</option>

                            <option>Adulto mayor</option>

                            <option>Niño</option>

                            <option>Familia completa</option>

                            <option>Necesita atención médica</option>

                            <option>Otro</option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Prioridad"></label>

                        <select asp-for="Prioridad"
                                class="form-select">

                            <option value="">Seleccione...</option>

                            <option>Baja</option>

                            <option>Media</option>

                            <option>Alta</option>

                            <option>Urgente</option>

                        </select>

                    </div>

                </div>

                <div class="form-check mt-3">

                    <input asp-for="RiesgoInmediato"
                           class="form-check-input" />

                    <label asp-for="RiesgoInmediato"
                           class="form-check-label">

                        La persona necesita atención inmediata

                    </label>

                </div>

                <div class="mt-3">

                    <label asp-for="Descripcion"></label>

                    <textarea asp-for="Descripcion"
                              rows="5"
                              class="form-control"></textarea>

                </div>

                <input asp-for="Latitud"
                       hidden
                       id="Latitud" />

                <input asp-for="Longitud"
                       hidden
                       id="Longitud" />

                <div class="row mt-3">

                    <div class="col-md-6">

                        <label asp-for="Sector"></label>

                        <input asp-for="Sector"
                               id="Sector"
                               readonly
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Direccion"></label>

                        <input asp-for="Direccion"
                               id="Direccion"
                               readonly
                               class="form-control" />

                    </div>

                </div>

                <div class="mt-4">

                    <partial name="_MapaUbicacion" />

                </div>

                <div class="mt-4 text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                    <button class="btn btn-primary">

                        Guardar Reporte

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <partial name="_LeafletScripts" />

}